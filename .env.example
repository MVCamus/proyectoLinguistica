# Google Drive (OBLIGATORIO: configurar el ID de la carpeta raíz)
GOOGLE_DRIVE_FOLDER_ID=

# Base de datos (PostgreSQL / Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres

# App
CORPUS_TARGET=400
POOL_SIZE=1500
TRIAGE_BLOCK_SIZE=20

# Hashtags por defecto para la ingesta
DEFAULT_HASHTAGS=["noticias","aprendeentiktok","español"]

# Whisper
WHISPER_MODEL=medium
WHISPER_CPU_THREADS=4
WHISPER_LANGUAGE=es

# Rutas (relativas al proyecto)
TMP_AUDIO_DIR=./tmp/harvester
LOG_FILE=logs/harvester.log
